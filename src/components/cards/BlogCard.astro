---
import LearningVisual from '../learning/LearningVisual.astro';
interface Props {
  title: string;
  summary: string;
  topic: string;
  publishedAt: Date;
  tags: string[];
  slug: string;
  visualStyle?: 'system-map' | 'protocol-flow' | 'ai-lifecycle';
}
const { title, summary, topic, publishedAt, tags, slug, visualStyle } = Astro.props;
const formattedDate = publishedAt.toLocaleDateString('en-US', { day: 'numeric', month: 'short', year: 'numeric' });
---
<article class="card-surface h-full overflow-hidden">
  <LearningVisual title={title} topic={topic} tags={tags} slug={slug} model={visualStyle} compact />
  <div class="p-6">
    <div class="flex flex-wrap items-center gap-3 text-xs font-semibold text-slate-400">
      <span>Lesson note</span><span aria-hidden="true">/</span><time datetime={publishedAt.toISOString()}>{formattedDate}</time>
    </div>
    <p class="mt-3 text-xs font-semibold text-brand-200">{topic}</p>
    <h3 class="mt-2 text-2xl font-semibold text-white">{title}</h3>
    <p class="mt-3 text-sm leading-7 text-slate-300">{summary}</p>
    <ul class="mt-5 flex flex-wrap gap-2 p-0" aria-label="Lesson tags">
      {tags.slice(0, 3).map((tag) => <li class="list-none rounded-md border border-white/10 px-3 py-1 text-xs text-slate-200">{tag}</li>)}
    </ul>
    <a href={`/blog/${slug}`} class="mt-6 inline-flex min-h-11 items-center text-sm font-semibold text-brand-200">Open lesson note</a>
  </div>
</article>
