---
import LearningVisual from '../learning/LearningVisual.astro';
interface Props {
  title: string;
  summary: string;
  topic: string;
  format: string;
  level: string;
  slug: string;
  tags?: string[];
  visualStyle?: 'system-map' | 'protocol-flow' | 'ai-lifecycle';
  downloadUrl?: string;
  ctaLabel?: string;
}
const { title, summary, topic, format, level, slug, tags = [], visualStyle, downloadUrl, ctaLabel = 'Download resource' } = Astro.props;
---
<article class="card-surface h-full overflow-hidden">
  <LearningVisual title={title} topic={topic} tags={tags} slug={slug} model={visualStyle} compact />
  <div class="p-6">
    <div class="flex flex-wrap gap-2 text-xs font-semibold text-slate-400">
      <span>{topic}</span><span aria-hidden="true">/</span><span>{format}</span><span aria-hidden="true">/</span><span>{level}</span>
    </div>
    <h3 class="mt-4 text-xl font-semibold text-white">{title}</h3>
    <p class="mt-3 text-sm leading-7 text-slate-300">{summary}</p>
    <div class="mt-6 flex flex-wrap gap-3">
      <a href={`/resources/${slug}`} class="inline-flex min-h-11 items-center rounded-lg bg-brand-500 px-4 py-2 text-sm font-semibold text-white transition hover:bg-brand-400">Open lesson</a>
      {downloadUrl && <a href={downloadUrl} download class="inline-flex min-h-11 items-center rounded-lg border border-white/15 px-4 py-2 text-sm font-semibold text-slate-100 transition hover:border-white/30 hover:bg-white/5">{ctaLabel}</a>}
    </div>
  </div>
</article>
