---
import { siteConfig } from '../../data/site';
---
<footer>
  <div class="container-shell footer-inner">
    <p>Haikal Shiddiq <span>Learning &amp; research</span></p>
    <nav aria-label="Footer">
      <a href="/about">About</a>
      <a href="/publications">Publications</a>
      <a href="/contact">Contact</a>
      {siteConfig.socialLinks.map((item) => <a href={item.href} target={item.href.startsWith('http') ? '_blank' : undefined} rel={item.href.startsWith('http') ? 'noreferrer' : undefined}>{item.label}</a>)}
    </nav>
  </div>
</footer>
<style>
  footer { border-top: 1px solid #cbd5e1; padding: 1rem 0; }
  .footer-inner { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 0.5rem 2rem; }
  p { margin: 0; color: #0f172a; font-size: 0.85rem; font-weight: 600; }
  p span { display: block; color: #475569; font-size: 0.75rem; font-weight: 400; }
  nav { display: flex; flex-wrap: wrap; gap: 0.25rem 1rem; }
  a { display: inline-flex; min-height: 44px; align-items: center; color: #475569; font-size: 0.82rem; }
  a:hover { color: #2346bd; text-decoration: underline; }
  html.dark footer { border-color: #334155; }
  html.dark p { color: #f8fafc; }
  html.dark p span, html.dark a { color: #cbd5e1; }
</style>
