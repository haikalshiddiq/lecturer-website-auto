---
import { siteConfig } from '../../data/site';
import ThemeToggle from './ThemeToggle.astro';
const pathname = Astro.url.pathname;
---
<header class="sticky top-0 z-50 border-b border-white/10 bg-slate-950/85 backdrop-blur-xl">
  <div class="container-shell flex flex-wrap items-center justify-between gap-4 py-4">
    <a href="/" class="flex items-center gap-3 text-sm font-semibold tracking-[0.24em] text-white uppercase">
      <span class="flex h-10 w-10 items-center justify-center rounded-2xl bg-brand-500 text-base font-bold text-white shadow-soft">HS</span>
      <span class="hidden sm:inline">Haikal Shiddiq</span>
    </a>
    <nav class="hidden items-center gap-3 xl:gap-5 lg:flex" aria-label="Main navigation">
      {siteConfig.navigation.map((item) => (
        <a
          href={item.href}
          class={`inline-flex min-h-11 items-center text-sm transition ${pathname === item.href || pathname.startsWith(`${item.href}/`) ? 'text-white' : 'text-slate-300 hover:text-white'}`}
        >
          {item.label}
        </a>
      ))}
    </nav>
    <div class="flex items-center gap-3">
      <ThemeToggle />
      <details class="mobile-navigation lg:hidden">
        <summary>Menu</summary>
        <nav aria-label="Mobile navigation">
          {siteConfig.navigation.map((item) => <a href={item.href}>{item.label}</a>)}
          <a href="/learn">Guided learning</a>
        </nav>
      </details>
    </div>
  </div>
</header>
<style>
  .mobile-navigation { position: relative; }
  summary { display: flex; align-items: center; min-height: 44px; padding: 0 0.75rem; border: 1px solid #94a3b8; border-radius: 0.5rem; color: #0f172a; font-size: 0.85rem; cursor: pointer; }
  .mobile-navigation nav { position: absolute; right: 0; top: calc(100% + 0.5rem); width: 200px; padding: 0.5rem; border: 1px solid #cbd5e1; border-radius: 0.75rem; background: #fff; box-shadow: 0 8px 24px rgb(15 23 42 / 0.12); }
  .mobile-navigation a { display: flex; align-items: center; min-height: 44px; padding: 0.5rem 0.75rem; color: #334155; font-size: 0.9rem; }
  .mobile-navigation a:hover { background: #e5eaff; }
  html.dark summary, html.dark .mobile-navigation a { color: #f8fafc; }
  html.dark .mobile-navigation nav { border-color: #64748b; background: #0f172a; }
  html.dark .mobile-navigation a:hover { background: #24304a; }
</style>
<script is:inline>
  document.querySelectorAll('.mobile-navigation').forEach((menu) => {
    menu.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') { menu.open = false; menu.querySelector('summary').focus(); }
    });
  });
</script>
