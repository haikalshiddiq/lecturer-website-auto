  .quiz-options button[data-selected="incorrect"] { border-color: #fb7185; background: rgb(244 63 94 / 0.12); }
  .quiz-result { min-height: 1.5rem; color: #cbd5e1; }
  .learning-state { display: grid; gap: 0.5rem; justify-items: start; border: 1px solid rgb(255 255 255 / 0.12); border-radius: 0.9rem; padding: 1.25rem; background: #0b1730; color: #cbd5e1; }
  .learning-state strong { color: #fff; }
  .learning-error { margin-top: 1rem; border-color: #fb7185; }
  [hidden] { display: none !important; }
  html:not(.dark) .guided-learning { color: #334155; }
  html:not(.dark) .learning-intro h2,
  html:not(.dark) .module-heading h3,
  html:not(.dark) .section-title-row h4,
  html:not(.dark) .practice-brief h4,
  html:not(.dark) .knowledge-check h4 { color: #0f172a; }
  html:not(.dark) .learning-workspace { border-color: #cbd5e1; background: #fff; box-shadow: 0 24px 70px rgb(15 23 42 / 0.1); }
  html:not(.dark) .module-rail { border-color: #cbd5e1; background: #e8edff; }
  html:not(.dark) .module-tab { color: #334155; }
  html:not(.dark) .module-tab[aria-selected="true"] { background: #dbe4ff; color: #0f172a; }
  html:not(.dark) .module-purpose,
  html:not(.dark) .checkpoint-row small,
  html:not(.dark) .practice-brief > p,
  html:not(.dark) .quiz-result { color: #475569; }
  html:not(.dark) .checkpoint-row { border-color: #cbd5e1; background: #f8fafc; }
  html:not(.dark) .practice-brief { background: #eef2ff; }
  html:not(.dark) .practice-brief label { color: #1e293b; }
  html:not(.dark) .practice-brief select,
  html:not(.dark) .practice-brief textarea { border-color: #64748b; background: #fff; color: #0f172a; }
  html:not(.dark) .quiz-options button { border-color: #64748b; color: #1e293b; }
  html:not(.dark) .learning-state { border-color: #cbd5e1; background: #eef2ff; color: #334155; }
  html:not(.dark) .learning-state strong { color: #0f172a; }
  @media (min-width: 64rem) {
    .learning-intro { grid-template-columns: 1.15fr 0.85fr; }
    .learning-workspace { grid-template-columns: 20rem minmax(0, 1fr); }
    .module-rail { display: block; overflow: visible; padding: 1.25rem; border-right: 1px solid rgb(255 255 255 / 0.1); border-bottom: 0; }
    .rail-title { display: block; padding: 0.75rem; }
    .module-tab { width: 100%; margin-top: 0.5rem; }
    .checkpoint-layout { grid-template-columns: minmax(0, 1.1fr) minmax(18rem, 0.9fr); }
    .knowledge-check { grid-template-columns: 0.8fr 1.2fr; }
  }
</style>
