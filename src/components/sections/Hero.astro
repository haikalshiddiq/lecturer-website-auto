---

import LearningVisual from '../learning/LearningVisual.astro';
interface Props {
  topics: { title: string; slug: string }[];
  resources: { title: string; slug: string; topic: string; tags: string[]; level: string }[];
}
const { topics, resources } = Astro.props;
const featuredResource = resources[0];
---
<section class="academy-hero" aria-labelledby="academy-title">
  <div class="container-shell academy-shell">
    <div class="academy-main">
      <div class="academy-heading">
        <h1 id="academy-title">Your learning workspace.</h1>
        <p>Systems, protocols, and applied AI. Choose a track or pick up a lesson.</p>
      </div>
      <div class="course-catalog">
        <header><h2>Learning tracks</h2><a href="/expertise">Course outlines</a></header>
        <div class="course-list">
          {topics.map((topic) => (
            <a class="course-row" href={`/expertise/${topic.slug}`}>
              <strong>{topic.title}</strong>
              <span>{resources.filter((resource) => resource.topic === topic.title).length} materials</span>
            </a>
          ))}
        </div>
      </div>
      <nav class="academy-actions" aria-label="Learning tools">
        <a href="/resources">Browse all materials</a>
        <a href="/learn">Guided learning &amp; quiz</a>
      </nav>
    </div>
    {featuredResource && (
      <aside class="continue-panel" data-continue-panel aria-labelledby="continue-heading">
        <header><h2 id="continue-heading">Continue learning</h2><span data-progress-status>Start a lesson</span></header>
        <LearningVisual title={featuredResource.title} topic={featuredResource.topic} tags={featuredResource.tags} slug={featuredResource.slug} compact />
        <div class="continue-body">
          <span>{featuredResource.level}</span>
          <h3 data-continue-title>{featuredResource.title}</h3>
          <a class="resume-link" href={`/resources/${featuredResource.slug}`}>Open lesson</a>
        </div>
      </aside>
    )}
  </div>
  <script is:inline>
    const panel = document.querySelector('[data-continue-panel]');
    if (panel) {
      try {
        const last = JSON.parse(localStorage.getItem('hicall-last-lesson-v1') || 'null');
        if (typeof last?.href === 'string' && /^\/(resources|blog)\/[a-z0-9-]+\/?$/.test(last.href) && typeof last.title === 'string') {
          panel.querySelector('[data-continue-title]').textContent = last.title;
          panel.querySelector('a').href = last.href;
          panel.querySelector('[data-progress-status]').textContent = last.completed ? 'Ready to review' : 'Progress restored';
        }
      } catch { panel.querySelector('[data-progress-status]').textContent = 'Start a lesson'; }
    }
  </script>
</section>
<style>
  .academy-hero { padding: 1.5rem 0; }
  .academy-shell { display: grid; gap: 1rem; }
  .academy-main, .continue-panel { min-width: 0; border: 1px solid #cbd5e1; border-radius: 1rem; background: #fff; }
  .academy-heading { padding: 1.5rem; border-bottom: 1px solid #cbd5e1; }
  h1 { margin: 0; color: #0f172a; font-size: clamp(1.8rem, 3vw, 2.6rem); font-weight: 650; line-height: 1.12; letter-spacing: -0.035em; }
  .academy-heading p { max-width: 55ch; margin: 0.75rem 0 0; color: #475569; font-size: 0.95rem; line-height: 1.6; }
  .course-catalog { padding: 1rem 1.5rem 0.5rem; }
  header { display: flex; align-items: center; justify-content: space-between; gap: 0.5rem 1rem; flex-wrap: wrap; }
  h2 { margin: 0; color: #0f172a; font-size: 1rem; font-weight: 650; }
  header a, .academy-actions a { display: inline-flex; min-height: 44px; align-items: center; color: #2346bd; font-size: 0.88rem; font-weight: 600; }
  .course-list { border-top: 1px solid #cbd5e1; }
  .course-row { display: grid; grid-template-columns: minmax(0, 1fr) auto; align-items: center; gap: 0.65rem; min-height: 62px; border-bottom: 1px solid #cbd5e1; padding: 0.65rem 0; }
  .course-row strong { color: #0f172a; font-size: 0.95rem; font-weight: 600; }
  .course-row span { color: #475569; font-size: 0.78rem; white-space: nowrap; }
  .course-row:hover strong { color: #2346bd; }
  .academy-actions { display: flex; flex-wrap: wrap; gap: 0 1.25rem; padding: 0 1.5rem 1rem; }
  .continue-panel { align-self: start; padding: 1rem; }
  .continue-panel header { margin-bottom: 0.75rem; }
  .continue-panel header span { color: #475569; font-size: 0.75rem; }
  .continue-panel :global(svg) { max-height: 140px; }
  .continue-body { padding-top: 0.85rem; }
  .continue-body > span { color: #475569; font-size: 0.78rem; }
  .resume-link { display: inline-flex; align-items: center; min-height: 44px; border-radius: 0.5rem; background: #3154c8; padding: 0.6rem 1rem; color: #fff; font-size: 0.88rem; font-weight: 600; }
  .resume-link:hover { background: #2346bd; }
  h3 { margin: 0.35rem 0 1rem; color: #0f172a; font-size: 1.15rem; font-weight: 650; line-height: 1.3; }
  html.dark .academy-main, html.dark .continue-panel { border-color: #334155; background: #0f172a; }
  html.dark .academy-heading, html.dark .course-list, html.dark .course-row { border-color: #334155; }
  html.dark h1, html.dark h2, html.dark h3, html.dark .course-row strong { color: #f8fafc; }
  html.dark p, html.dark .course-row span, html.dark .continue-panel header span, html.dark .continue-body > span { color: #cbd5e1; }
  html.dark header a, html.dark .academy-actions a, html.dark .course-row:hover strong { color: #95b3ff; }
  @media (min-width: 960px) { .academy-shell { grid-template-columns: minmax(0, 1.4fr) minmax(300px, 0.8fr); gap: 1.5rem; } }
  @media (max-width: 520px) { .academy-heading { padding: 1.25rem; } .course-catalog { padding-inline: 1.25rem; } .academy-actions { padding-inline: 1.25rem; } .course-row strong { font-size: 0.88rem; } }
</style>
