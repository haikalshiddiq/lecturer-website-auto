---
import ActionLink from '../ui/ActionLink.astro';
import LearningVisual from '../learning/LearningVisual.astro';

interface TopicItem {
  title: string;
  slug: string;
  summary: string;
}
interface ResourceItem {
  title: string;
  slug: string;
  summary: string;
  topic: string;
  tags: string[];
  level: string;
}
interface Props {
  topics: TopicItem[];
  resources: ResourceItem[];
}

const { topics, resources } = Astro.props;
const featuredResource = resources[0];
const resourceCountByTopic = new Map(topics.map((topic) => [topic.title, resources.filter((resource) => resource.topic === topic.title).length]));
---
<section class="academy-hero" aria-labelledby="academy-title">
  <div class="container-shell academy-shell">
    <div class="academy-main">
      <div class="academy-heading">
        <p class="academy-kicker">Lecturer learning platform</p>
        <h1 id="academy-title">Choose a course. Build evidence as you learn.</h1>
        <p>Study systems, protocols, and applied AI through guided lessons, practical labs, and class-ready resources.</p>
      </div>

      <div class="course-catalog" aria-labelledby="course-catalog-title">
        <div class="course-catalog__header">
          <div>
            <p>Course catalog</p>
            <h2 id="course-catalog-title">Three connected learning tracks</h2>
          </div>
          <a href="/expertise">View course outlines</a>
        </div>
        <div class="course-list">
          {topics.map((topic, index) => (
            <a class="course-row" href={`/expertise/${topic.slug}`}>
              <span class="course-row__index" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
              <span class="course-row__copy">
                <strong>{topic.title}</strong>
                <small>{topic.summary}</small>
              </span>
              <span class="course-row__count">{resourceCountByTopic.get(topic.title)} materials</span>
            </a>
          ))}
        </div>
      </div>
    </div>

    {featuredResource && (
      <aside class="continue-panel" data-continue-panel aria-labelledby="continue-title">
        <div class="continue-panel__heading">
          <p>Continue learning</p>
          <span data-progress-status>Saved on this device</span>
        </div>
        <LearningVisual
          title={featuredResource.title}
          topic={featuredResource.topic}
          tags={featuredResource.tags}
          slug={featuredResource.slug}
          compact
        />
        <div class="continue-panel__body">
          <span>{featuredResource.level} course material</span>
          <h2 id="continue-title" data-continue-title>{featuredResource.title}</h2>
          <p>{featuredResource.summary}</p>
          <div class="continue-actions">
            <ActionLink href={`/resources/${featuredResource.slug}`} size="sm" lift={false}>Resume lesson</ActionLink>
            <ActionLink href="/resources" variant="secondary" size="sm" lift={false}>Open catalog</ActionLink>
          </div>
        </div>
      </aside>
    )}
  </div>

  <script is:inline>
    const panel = document.querySelector('[data-continue-panel]');
    if (panel) {
      try {
        const lastLesson = JSON.parse(localStorage.getItem('hicall-last-lesson-v1') || 'null');
        if (lastLesson?.href && lastLesson?.title) {
          const title = panel.querySelector('[data-continue-title]');
          const resume = panel.querySelector('a');
          const status = panel.querySelector('[data-progress-status]');
          title.textContent = lastLesson.title;
          resume.href = lastLesson.href;
          status.textContent = lastLesson.completed ? 'Completed. Review anytime.' : 'Progress restored';
        }
      } catch {
        panel.querySelector('[data-progress-status]').textContent = 'Progress starts when you open a lesson';
      }
    }
  </script>
</section>

<style>
  .academy-hero { padding: 3rem 0 2rem; }
  .academy-shell { display: grid; gap: 1.5rem; }
  .academy-main, .continue-panel { min-width: 0; border: 1px solid #cbd5e1; background: rgb(255 255 255 / 0.88); }
  .academy-main { border-radius: 1.25rem; overflow: hidden; }
  .academy-heading { padding: clamp(1.5rem, 4vw, 3rem); border-bottom: 1px solid #cbd5e1; }
  .academy-kicker, .course-catalog__header p, .continue-panel__heading p { margin: 0; color: #3154c8; font-size: 0.78rem; font-weight: 750; letter-spacing: 0.08em; text-transform: uppercase; }
  .academy-heading h1 { max-width: 16ch; margin: 0.65rem 0 0; color: #0f172a; font-size: clamp(2.4rem, 6vw, 4.8rem); line-height: 0.98; letter-spacing: -0.055em; }
  .academy-heading > p:last-child { max-width: 58ch; margin: 1.25rem 0 0; color: #475569; font-size: 1.05rem; line-height: 1.65; }
  .course-catalog { padding: 1.25rem clamp(1.25rem, 4vw, 2rem) 1.5rem; }
  .course-catalog__header { display: flex; align-items: end; justify-content: space-between; gap: 1rem; margin-bottom: 1rem; }
  .course-catalog__header h2 { margin: 0.25rem 0 0; color: #0f172a; font-size: 1.25rem; }
  .course-catalog__header a { min-height: 44px; display: inline-flex; align-items: center; color: #2346bd; font-weight: 700; }
  .course-list { border-top: 1px solid #cbd5e1; }
  .course-row { display: grid; grid-template-columns: 2.5rem minmax(0, 1fr) auto; align-items: center; gap: 1rem; min-height: 76px; border-bottom: 1px solid #cbd5e1; color: inherit; text-decoration: none; }
  .course-row:hover .course-row__copy strong { color: #2346bd; }
  .course-row__index { color: #64748b; font-family: ui-monospace, monospace; font-size: 0.8rem; }
  .course-row__copy { min-width: 0; display: grid; gap: 0.2rem; }
  .course-row__copy strong { color: #0f172a; transition: color 160ms ease; }
  .course-row__copy small { overflow: hidden; color: #64748b; text-overflow: ellipsis; white-space: nowrap; }
  .course-row__count { color: #475569; font-size: 0.82rem; }
  .continue-panel { align-self: start; border-radius: 1.25rem; padding: 1rem; }
  .continue-panel__heading { display: flex; justify-content: space-between; gap: 1rem; padding: 0.25rem 0.25rem 1rem; }
  .continue-panel__heading span { color: #64748b; font-size: 0.75rem; text-align: right; }
  .continue-panel__body { padding: 1.25rem 0.25rem 0.4rem; }
  .continue-panel__body > span { color: #64748b; font-size: 0.8rem; }
  .continue-panel h2 { margin: 0.45rem 0 0; color: #0f172a; font-size: 1.55rem; line-height: 1.15; }
  .continue-panel__body p { margin: 0.75rem 0 0; color: #475569; font-size: 0.9rem; line-height: 1.6; }
  .continue-actions { display: flex; flex-wrap: wrap; gap: 0.65rem; margin-top: 1.25rem; }
  html.dark .academy-main, html.dark .continue-panel { border-color: #334155; background: rgb(15 23 42 / 0.9); }
  html.dark .academy-heading, html.dark .course-list, html.dark .course-row { border-color: #334155; }
  html.dark .academy-heading h1, html.dark .course-catalog__header h2, html.dark .course-row__copy strong, html.dark .continue-panel h2 { color: #f8fafc; }
  html.dark .academy-heading > p:last-child, html.dark .course-row__count, html.dark .continue-panel__body p { color: #cbd5e1; }
  html.dark .academy-kicker, html.dark .course-catalog__header p, html.dark .continue-panel__heading p, html.dark .course-catalog__header a { color: #95b3ff; }
  @media (min-width: 1024px) {
    .academy-shell { grid-template-columns: minmax(0, 1.42fr) minmax(320px, 0.58fr); align-items: start; }
  }
  @media (max-width: 639px) {
    .academy-hero { padding-top: 1.5rem; }
    .course-catalog__header { align-items: flex-start; flex-direction: column; }
    .course-row { grid-template-columns: 2rem minmax(0, 1fr); padding: 0.8rem 0; }
    .course-row__copy small { white-space: normal; }
    .course-row__count { grid-column: 2; }
  }
</style>
