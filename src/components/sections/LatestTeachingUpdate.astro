---
import ActionLink from '../ui/ActionLink.astro';

interface LatestPost {
  title: string;
  summary: string;
  topic: string;
  publishedAt: Date;
  tags: string[];
  slug: string;
}

interface Props {
  post?: LatestPost;
}

const { post } = Astro.props;
const formattedDate = post?.publishedAt.toLocaleDateString('en-US', {
  day: 'numeric',
  month: 'long',
  year: 'numeric'
});
---
{post && (
  <section id="today-update" class="py-12 sm:py-16">
    <div class="container-shell">
      <article class="relative overflow-hidden rounded-[2rem] border border-brand-300/30 bg-gradient-to-br from-brand-500/20 via-sky-500/10 to-cyan-400/10 p-6 shadow-soft backdrop-blur sm:p-8 lg:p-10">
        <div class="absolute inset-y-0 right-0 hidden w-1/2 bg-[radial-gradient(circle_at_center,rgba(56,189,248,0.28),transparent_58%)] lg:block"></div>
        <div class="relative grid gap-8 lg:grid-cols-[0.85fr_1.15fr] lg:items-center">
          <div>
            <p class="text-sm font-semibold uppercase tracking-[0.22em] text-brand-100">Today's teaching update</p>
            <h2 class="mt-4 text-3xl font-semibold tracking-tight text-white sm:text-4xl">New content is live on the blog.</h2>
            <p class="mt-4 max-w-xl text-sm leading-7 text-slate-300">The automated daily update now appears here, on the blog index, in topic coverage, RSS, and its own article page.</p>
          </div>

          <div class="rounded-[1.75rem] border border-white/10 bg-white/10 p-5 sm:p-6">
            <div class="flex flex-wrap items-center gap-3 text-xs font-medium uppercase tracking-[0.18em] text-slate-300">
              <span>{post.topic}</span>
              <span aria-hidden="true">/</span>
              <time datetime={post.publishedAt.toISOString()}>{formattedDate}</time>
            </div>
            <h3 class="mt-4 text-2xl font-semibold text-white sm:text-3xl">{post.title}</h3>
            <p class="mt-3 text-sm leading-7 text-slate-300">{post.summary}</p>
            <div class="mt-5 flex flex-wrap gap-2">
              {post.tags.slice(0, 4).map((tag) => (
                <span class="rounded-full border border-white/10 bg-white/10 px-3 py-1 text-xs text-slate-200">{tag}</span>
              ))}
            </div>
            <div class="mt-6 flex flex-wrap gap-3">
              <ActionLink href={`/blog/${post.slug}`} variant="brand" size="sm">Read latest update</ActionLink>
              <ActionLink href="/blog" variant="secondary" size="sm">Open blog</ActionLink>
            </div>
          </div>
        </div>
      </article>
    </div>
  </section>
)}
