---
import ActionLink from '../ui/ActionLink.astro';
import LearningVisual from '../learning/LearningVisual.astro';
import PagedCatalog from '../learning/PagedCatalog.astro';
interface ResourceItem {
  title: string; slug: string; summary: string; topic: string; level: string; format: string; tags: string[];
  visualStyle?: 'system-map' | 'protocol-flow' | 'ai-lifecycle'; downloadUrl?: string; ctaLabel?: string;
}
interface Props { resources: ResourceItem[]; title?: string; description?: string; }
const { resources, title = 'Course materials', description = 'Find a lesson, open its visual model, and practise at your own pace.' } = Astro.props;
---
<section id="resource-explorer" class="resource-catalog" data-resource-explorer>
  <div class="container-shell">
    <header class="catalog-heading"><h1>{title}</h1><p>{description}</p><a href="/learn">Open guided learning &amp; quiz</a></header>
    <PagedCatalog id="resources" total={resources.length}>
      <div class="catalog-grid">
        {resources.map((resource, index) => (
          <article data-resource-card={resource.topic} data-catalog-item data-catalog-topic={resource.topic} data-catalog-search={`${resource.title} ${resource.topic} ${resource.tags.join(' ')}`} class="resource-card" hidden={index >= 3}>
            <LearningVisual title={resource.title} topic={resource.topic} tags={resource.tags} slug={resource.slug} model={resource.visualStyle} compact />
            <div class="resource-card__body">
              <div class="resource-card__meta"><span>{resource.format}</span><span>{resource.level}</span></div>
              <h2>{resource.title}</h2>
              <p>{resource.summary}</p>
              <div class="resource-card__actions">
                <ActionLink href={`/resources/${resource.slug}`} variant="brand" size="sm" lift={false}>Open lesson</ActionLink>
                {resource.downloadUrl && <a class="download-link" href={resource.downloadUrl} download>{resource.ctaLabel ?? 'Download'}</a>}
              </div>
            </div>
          </article>
        ))}
      </div>
    </PagedCatalog>
  </div>
</section>
<style>
  .resource-catalog { padding: 2rem 0; }
  .catalog-heading h1 { margin: 0; color: #0f172a; font-size: clamp(1.8rem, 3vw, 2.5rem); font-weight: 650; line-height: 1.15; letter-spacing: -0.03em; }
  .catalog-heading p { margin: 0.65rem 0 0; color: #475569; line-height: 1.6; }
  .catalog-heading a, .download-link { display: inline-flex; min-height: 44px; align-items: center; color: #2346bd; font-size: 0.85rem; font-weight: 600; }
  .catalog-grid { display: grid; gap: 1.25rem; margin-top: 1rem; }
  .resource-card { min-width: 0; border: 1px solid #cbd5e1; border-radius: 0.75rem; background: #fff; }
  .resource-card[hidden] { display: none; }
  .resource-card :global(.learning-visual) { border: 0; border-bottom: 1px solid #cbd5e1; border-radius: 0.75rem 0.75rem 0 0; }
  .resource-card :global(svg) { max-height: 150px; }
  .resource-card__body { padding: 1rem; }
  .resource-card__meta { display: flex; justify-content: space-between; gap: 1rem; color: #475569; font-size: 0.75rem; }
  .resource-card h2 { margin: 0.65rem 0 0; color: #0f172a; font-size: 1.15rem; font-weight: 650; line-height: 1.3; }
  .resource-card p { margin: 0.6rem 0 0; color: #475569; font-size: 0.88rem; line-height: 1.6; }
  .resource-card__actions { display: flex; flex-wrap: wrap; gap: 0.6rem; margin-top: 1rem; }
  html.dark .catalog-heading h1, html.dark .resource-card h2 { color: #f8fafc; }
  html.dark .catalog-heading p, html.dark .resource-card p, html.dark .resource-card__meta { color: #cbd5e1; }
  html.dark .catalog-heading a, html.dark .download-link { color: #95b3ff; }
  html.dark .resource-card, html.dark .resource-card :global(.learning-visual) { border-color: #334155; }
  html.dark .resource-card { background: #0f172a; }
  @media (min-width: 1000px) { .catalog-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
</style>
