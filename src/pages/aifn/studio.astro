---
import SEOHead from '../../components/layout/SEOHead.astro';
import course from '../../data/aifn-course.json';
import '../../styles/global.css';
import '../../styles/aifn-studio.css';
---
<!doctype html>
<html lang="id" data-aifn-studio>
<head>
  <SEOHead title="Studio AiFn | Artificial Intelligence in Finance" description="16 pertemuan AI keuangan dengan simulator sintetis, praktik Python offline, kuis, dan panduan pengajar publik." />
  <script is:inline>
    (()=>{let saved;try{saved=localStorage.getItem('theme');}catch{}const dark=saved?saved==='dark':matchMedia('(prefers-color-scheme: dark)').matches;document.documentElement.classList.toggle('dark',dark);document.documentElement.dataset.theme=dark?'dark':'light';})();
  </script>
</head>
<body class="aifn">
  <a class="af-skip" href="#aifn-main">Lewati navigasi</a>
  <header class="af-top"><a class="af-brand" href="/aifn">AiFn / Studio</a><a href="/">Situs dosen</a><a id="aifn-mode" href="?mode=teach#1">Pengajar publik</a><button id="aifn-theme" type="button">Ganti tema</button></header>
  <div id="aifn-app" aria-busy="true"><p class="af-notice" role="status">Menyiapkan 16 pertemuan lokal…</p></div>
  <p id="aifn-status" class="af-status" role="status" aria-live="polite" style="max-width:1350px;margin:0 auto;padding:0 1rem"></p>
  <noscript><p>Studio interaktif memerlukan JavaScript. <a href="/aifn">Peta RPS dan unduhan notebook dapat dibaca di ikhtisar AiFn.</a></p></noscript>
  <script id="aifn-course-data" is:inline type="application/json" set:html={JSON.stringify(course).replace(/</g,'\\u003c')} />
  <script>import '../../scripts/aifn-studio.js';</script>
</body>
</html>
