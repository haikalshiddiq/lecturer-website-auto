---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PagedCatalog from '../../components/learning/PagedCatalog.astro';
import LearningVisual from '../../components/learning/LearningVisual.astro';
import { getBlogPosts } from '../../lib/content';
const posts = await getBlogPosts();
---
<BaseLayout title="Lesson notes | Haikal Shiddiq" description="Search teaching notes on systems, protocols, and applied AI.">
  <section class="notes-library container-shell">
    <h1>Lesson notes</h1>
    <p class="intro">Daily teaching notes. Search a topic, then open a lesson.</p>
    <PagedCatalog id="notes" total={posts.length} pageSize={6}>
      <div class="notes-list">
        {posts.map((post, index) => (
          <article data-catalog-item data-catalog-topic={post.topic} data-catalog-search={`${post.title} ${post.topic} ${post.tags.join(' ')}`} hidden={index >= 6}>
            <div class="note-visual"><LearningVisual title={post.title} topic={post.topic} tags={post.tags} slug={post.slug} model={post.visualStyle} compact /></div>
            <div class="note-copy">
              <div class="note-meta"><span>{post.topic}</span><time datetime={post.publishedAt.toISOString()}>{post.publishedAt.toLocaleDateString('en-US', { day: 'numeric', month: 'short', year: 'numeric' })}</time></div>
              <h2><a href={`/blog/${post.slug}`}>{post.title}</a></h2>
            </div>
          </article>
        ))}
      </div>
    </PagedCatalog>
  </section>
</BaseLayout>
<style>
  .notes-library { padding-top: 2rem; padding-bottom: 2rem; }
  h1 { color: #0f172a; font-size: clamp(1.8rem, 3vw, 2.5rem); font-weight: 650; letter-spacing: -0.03em; }
  .intro { margin-top: 0.65rem; color: #475569; line-height: 1.6; }
  .notes-list { margin-top: 1rem; border-top: 1px solid #cbd5e1; }
  article { display: grid; grid-template-columns: 90px minmax(0, 1fr); align-items: center; gap: 1rem; padding: 0.85rem 0; border-bottom: 1px solid #cbd5e1; }
  article[hidden] { display: none; }
  .note-visual :global(figcaption) { display: none; }
  .note-meta { display: flex; flex-wrap: wrap; gap: 0.25rem 1rem; color: #475569; font-size: 0.75rem; }
  h2 { margin-top: 0.3rem; color: #0f172a; font-size: 1rem; font-weight: 600; line-height: 1.45; }
  h2 a { display: inline-flex; align-items: center; min-height: 44px; }
  h2 a:hover { color: #2346bd; text-decoration: underline; }
  html.dark h1, html.dark h2 { color: #f8fafc; }
  html.dark .intro, html.dark .note-meta { color: #cbd5e1; }
  html.dark .notes-list, html.dark article { border-color: #334155; }
  @media (max-width: 520px) { article { grid-template-columns: 64px minmax(0, 1fr); gap: 0.75rem; } h2 { font-size: 0.92rem; } }
</style>
