---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/sections/Hero.astro';
import { getBlogPosts, getResources, getTopics } from '../lib/content';

const topics = await getTopics();
const resources = await getResources();
const posts = (await getBlogPosts()).slice(0, 3);
---
<BaseLayout>
  <div data-compact-home>
    <Hero topics={topics} resources={resources} />
    <section class="home-notes container-shell" aria-labelledby="latest-notes-title">
      <header>
        <h2 id="latest-notes-title">Latest lesson notes</h2>
        <a href="/blog">All lesson notes</a>
      </header>
      <div class="note-list">
        {posts.map((post) => (
          <a href={`/blog/${post.slug}`}>
            <span>{post.topic}</span>
            <strong>{post.title}</strong>
            <time datetime={post.publishedAt.toISOString()}>{post.publishedAt.toLocaleDateString('en-US', { day: 'numeric', month: 'short' })}</time>
          </a>
        ))}
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .home-notes { padding-top: 0.5rem; padding-bottom: 2rem; }
  header { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 0.5rem 1rem; margin-bottom: 0.75rem; }
  h2 { color: #0f172a; font-size: 1.2rem; font-weight: 650; }
  header a { display: inline-flex; align-items: center; min-height: 44px; color: #2346bd; font-size: 0.9rem; font-weight: 600; }
  .note-list { border-top: 1px solid #cbd5e1; }
  .note-list a { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 0.2rem 1rem; padding: 0.85rem 0; border-bottom: 1px solid #cbd5e1; }
  .note-list span { color: #475569; font-size: 0.75rem; }
  .note-list strong { grid-column: 1; color: #0f172a; font-size: 0.95rem; font-weight: 600; line-height: 1.45; }
  .note-list time { grid-column: 2; grid-row: 1 / 3; align-self: center; color: #475569; font-size: 0.8rem; white-space: nowrap; }
  .note-list a:hover strong { color: #2346bd; }
  html.dark h2, html.dark .note-list strong { color: #f8fafc; }
  html.dark header a, html.dark .note-list a:hover strong { color: #95b3ff; }
  html.dark .note-list, html.dark .note-list a { border-color: #334155; }
  html.dark .note-list span, html.dark .note-list time { color: #cbd5e1; }
</style>
